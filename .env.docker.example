# MailPilot Docker Environment — Example
# Copy this file to .env.docker and fill in real values.
# The .env.docker file is gitignored and must NEVER be committed to version control.
#
# Usage:
#   cp .env.docker.example .env.docker
#   # Fill in your values below
#   docker compose --env-file .env.docker up -d

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=mailpilot
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here
POSTGRES_DB=mailpilot

# Full PostgreSQL connection string for the app (must match above credentials)
DATABASE_URL=postgresql://mailpilot:CHANGE_ME_strong_random_password_here@postgres:5432/mailpilot?schema=public
DIRECT_URL=postgresql://mailpilot:CHANGE_ME_strong_random_password_here@postgres:5432/mailpilot

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_strong_64_char_random_hex_secret
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# ─── CORS & URLs ──────────────────────────────────────────────────────────────
CLIENT_URL=https://yourdomain.com
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=MailPilot <no-reply@yourdomain.com>
EMAIL_REPLY_TO=support@yourdomain.com

# Resend Webhook Signing Secret (from Resend Dashboard → Webhooks)
# Add endpoint: POST https://api.yourdomain.com/api/webhooks/resend
# Copy the signing secret shown in the Resend dashboard
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─── Tracking Secret ──────────────────────────────────────────────────────────
# Must be different from JWT_SECRET
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_SECRET=CHANGE_ME_different_from_jwt_secret

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
AI_PROVIDER=openai
