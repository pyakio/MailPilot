# MailPilot — Root Environment Variables Example
# Copy to .env in workspace root or server/.env

# ─── Supabase PostgreSQL Database ─────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
