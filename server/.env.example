# MailPilot API — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development

# ─── Database (Supabase PostgreSQL & Prisma) ──────────────────────────────────
# Connection pool URL (from Supabase Database settings -> Connection string -> Transaction / Session mode)
DATABASE_URL=
# Direct URL for Prisma CLI migrations (from Supabase Database settings -> Session mode / Port 5432)
DIRECT_URL=

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com/
# Enable "Google Identity Services" and "Gmail API", create OAuth 2.0 credentials
# Authorized redirect URI: http://localhost:5050/api/auth/google/callback
# Authorized JS origins: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# ─── CORS & URLs ─────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
API_URL=http://localhost:5050

# ─── Email Service Provider (Resend / SMTP) ──────────────────────────────────
# Sign up at https://resend.com for API key
RESEND_API_KEY=
EMAIL_FROM=MailPilot <onboarding@resend.dev>
EMAIL_REPLY_TO=support@mailpilot.io

# (Optional) SMTP configuration for local fallback testing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ─── Tracking Secret ─────────────────────────────────────────────────────────
TRACKING_SECRET=change_me_for_email_tracking_hash

# ─── AI Assistant (Gemini) ───────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/app/apikey
# Supported model: gemini-3.6-flash (stable)
GEMINI_API_KEY=
AI_PROVIDER=gemini

# ─── Stripe Billing (Optional) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
