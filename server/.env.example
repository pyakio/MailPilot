# MailPilot API — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development

# ─── Database (Supabase PostgreSQL & Prisma) ──────────────────────────────────
# Connection pool URL (from Supabase Database settings -> Connection string -> Transaction / Session mode)
DATABASE_URL=
# Direct URL for Prisma CLI migrations (from Supabase Database settings -> Session mode / Port 5432)
DIRECT_URL=

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com/
# Enable "Google Identity Services" and create OAuth 2.0 credentials
# Add http://localhost:5173 as an authorized JavaScript origin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# ─── CORS & URLs ─────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
API_URL=http://localhost:5050

# ─── Email Service Provider (Resend / SMTP) ──────────────────────────────────
# Sign up at https://resend.com for API key
RESEND_API_KEY=
EMAIL_FROM=MailPilot <onboarding@resend.dev>
EMAIL_REPLY_TO=support@mailpilot.io

# (Optional) SMTP configuration for local fallback testing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ─── Tracking Secret ─────────────────────────────────────────────────────────
TRACKING_SECRET=change_me_for_email_tracking_hash

# ─── AI Assistant (OpenAI / Gemini) ──────────────────────────────────────────
# Get API key from https://platform.openai.com or https://ai.google.dev
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Stripe Billing (Optional) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
